<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Title="Smart Factory">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Ueberschriften im Steuerpanel -->
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#6B7055" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- Steuer-Buttons -->
        <Style Selector="Button.pad">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="Background" Value="#3A4150" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pad:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#525B6E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.pad:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="Button.wide">
            <Setter Property="Width" Value="86" />
        </Style>
        <!-- Reset-Button in der Mitte des Pfeilfelds, orange hervorgehoben -->
        <Style Selector="Button.reset">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FBBF24" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>

        <!-- Positionsanzeige -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#6B7055" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#2D3320" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Grid Width="900" Height="600">

        <!-- Fabrik -->
        <Grid>
            <Image Source="avares://smartFactoryApp/Assets/factory_plan.png" Stretch="None"/>

            <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" ClipToBounds="True">
                <!-- Zeichenreihenfolge: Baender, dann Steine, dann Roboter (was weiter unten steht, liegt oben) -->

                <!-- 8a: Foerderbaender, Position und Winkel aus dem ViewModel -->
                <Image Source="avares://smartFactoryApp/Assets/productionline_red.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionRedX}" Canvas.Top="{Binding ProductionRedY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionRedAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/productionline_blue.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionBlueX}" Canvas.Top="{Binding ProductionBlueY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionBlueAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/productionline_yellow.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionYellowX}" Canvas.Top="{Binding ProductionYellowY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionYellowAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/productionline_green.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionGreenX}" Canvas.Top="{Binding ProductionGreenY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionGreenAngle}" />
                    </Image.RenderTransform>
                </Image>

                <!-- 8b: Steine, je Farbe eine ItemsControl, die fuer jeden Eintrag der Liste ein Rechteck erzeugt -->
                <ItemsControl ItemsSource="{Binding RedBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#A41125">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding BlueBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#4462DA">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding YellowBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#F9E00A">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding GreenBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#299D24">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 8c: Roboter mit neuem Bild -->
                <Rectangle x:Name="robotRectangle" Width="70" Height="50" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}" >
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="{Binding RobotRotationAngle}" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <ImageBrush Source="avares://smartFactoryApp/Assets/robot.png" />
                    </Rectangle.Fill>
                </Rectangle>            </Canvas>
        </Grid>

        <!-- Steuerpanel im beigen Bereich des Fabrikplans (x 601 bis 899) -->
        <Border HorizontalAlignment="Left" Margin="601,0,0,0" Width="299" Padding="26,22">
            <StackPanel>
                <TextBlock Text="Smart Factory" Foreground="#2D3320" FontSize="20" FontWeight="Bold" />

                <!-- 8d: Timer der Foerderbaender starten/stoppen -->
                <TextBlock Classes="header" Text="BAENDER" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="StartButton" Classes="pad wide" Content="Start" FontSize="16" ToolTip.Tip="Foerderbaender starten" Click="StartTimer_Click" />
                    <Button x:Name="StopButton"  Classes="pad wide" Content="Stop"  FontSize="16" ToolTip.Tip="Foerderbaender anhalten" Click="StopTimer_Click" />
                </StackPanel>

                <TextBlock Classes="header" Text="BEWEGEN" />
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                    <Button x:Name="UpLeftButton"    Classes="pad" Grid.Row="0" Grid.Column="0" Content="↖" ToolTip.Tip="Hoch links"   Click="MoveUpLeft_Click" />
                    <Button x:Name="UpButton"        Classes="pad" Grid.Row="0" Grid.Column="1" Content="↑" ToolTip.Tip="Hoch"         Click="MoveUp_Click" />
                    <Button x:Name="UpRightButton"   Classes="pad" Grid.Row="0" Grid.Column="2" Content="↗" ToolTip.Tip="Hoch rechts"  Click="MoveUpRight_Click" />
                    <Button x:Name="LeftButton"      Classes="pad" Grid.Row="1" Grid.Column="0" Content="←" ToolTip.Tip="Links"        Click="MoveLeft_Click" />
                    <Button x:Name="ResetRotationButton" Classes="pad reset" Grid.Row="1" Grid.Column="1" Content="0°" ToolTip.Tip="Orientierung auf 0° zuruecksetzen" Click="ResetRotation_Click" />
                    <Button x:Name="RightButton"     Classes="pad" Grid.Row="1" Grid.Column="2" Content="→" ToolTip.Tip="Rechts"       Click="MoveRight_Click" />
                    <Button x:Name="DownLeftButton"  Classes="pad" Grid.Row="2" Grid.Column="0" Content="↙" ToolTip.Tip="Runter links" Click="MoveDownLeft_Click" />
                    <Button x:Name="DownButton"      Classes="pad" Grid.Row="2" Grid.Column="1" Content="↓" ToolTip.Tip="Runter"       Click="MoveDown_Click" />
                    <Button x:Name="DownRightButton" Classes="pad" Grid.Row="2" Grid.Column="2" Content="↘" ToolTip.Tip="Runter rechts" Click="MoveDownRight_Click" />
                </Grid>

                <TextBlock Classes="header" Text="DREHEN" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RotateLeftButton"  Classes="pad wide" Content="↺" ToolTip.Tip="Gegen den Uhrzeigersinn" Click="RotateLeft_Click" />
                    <Button x:Name="RotateRightButton" Classes="pad wide" Content="↻" ToolTip.Tip="Im Uhrzeigersinn"        Click="RotateRight_Click" />
                </StackPanel>

                <TextBlock Classes="header" Text="POSITION" />
                <Border Background="#DCE1C2" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Classes="label" Grid.Row="0" Text="X" />
                        <TextBlock x:Name="textBoxX" Classes="value" Grid.Row="0" Grid.Column="1" Text="{Binding RobotX, StringFormat='{}{0:0} px'}" />
                        <TextBlock Classes="label" Grid.Row="1" Text="Y" />
                        <TextBlock x:Name="textBoxY" Classes="value" Grid.Row="1" Grid.Column="1" Text="{Binding RobotY, StringFormat='{}{0:0} px'}" />
                        <TextBlock Classes="label" Grid.Row="2" Text="Winkel" />
                        <TextBlock Classes="value" Grid.Row="2" Grid.Column="1" Text="{Binding RobotRotationAngle, StringFormat='{}{0:0}°'}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>

</Window>
