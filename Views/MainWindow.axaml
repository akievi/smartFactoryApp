<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Title="Smart Factory">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Ueberschriften im Steuerpanel -->
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#6B7055" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <!-- Steuer-Buttons -->
        <Style Selector="Button.pad">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="Background" Value="#3A4150" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pad:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#525B6E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.pad:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <Style Selector="Button.wide">
            <Setter Property="Width" Value="82" />
        </Style>
        <!-- Reset-Button in der Mitte des Pfeilfelds, orange hervorgehoben -->
        <Style Selector="Button.reset">
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FBBF24" />
            <Setter Property="Foreground" Value="#1F2328" />
        </Style>
        <!-- Stop-Button in der Mitte des Pfeilfelds, rot hervorgehoben -->
        <Style Selector="Button.stop">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Positionsanzeige -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#6B7055" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#2D3320" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Grid Width="900" Height="600">

        <!-- Fabrik -->
        <Grid>
            <Image Source="avares://smartFactoryApp/Assets/factory_plan.png" Stretch="None"/>

            <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" ClipToBounds="True">
                <!-- Zeichenreihenfolge: Baender, dann Steine, dann Roboter (was weiter unten steht, liegt oben) -->

                <!-- 8a: Foerderbaender, Position und Winkel aus dem ViewModel -->
                <Image Source="avares://smartFactoryApp/Assets/productionline_red.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionRedX}" Canvas.Top="{Binding ProductionRedY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionRedAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/productionline_blue.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionBlueX}" Canvas.Top="{Binding ProductionBlueY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionBlueAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/productionline_yellow.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionYellowX}" Canvas.Top="{Binding ProductionYellowY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionYellowAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/productionline_green.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionGreenX}" Canvas.Top="{Binding ProductionGreenY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionGreenAngle}" />
                    </Image.RenderTransform>
                </Image>
                <!-- Zusatzbaender ohne Steine -->
                <Image Source="avares://smartFactoryApp/Assets/productionline_recycle.png" Width="90" Height="22"
                       Canvas.Left="{Binding ProductionRecycleX}" Canvas.Top="{Binding ProductionRecycleY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionRecycleAngle}" />
                    </Image.RenderTransform>
                </Image>
                <Image Source="avares://smartFactoryApp/Assets/delivery_line.png" Width="186" Height="30"
                       Canvas.Left="{Binding ProductionDeliveryX}" Canvas.Top="{Binding ProductionDeliveryY}">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding ProductionDeliveryAngle}" />
                    </Image.RenderTransform>
                </Image>
                                <!-- Pfeile neben dem Delivery-Band -->
                <Image Source="avares://smartFactoryApp/Assets/arrow_recycling.png" Width="110" Height="40"
                       Canvas.Left="{Binding ToRecycleX}" Canvas.Top="{Binding ToRecycleY}" />
                <Image Source="avares://smartFactoryApp/Assets/arrow_customers.png" Width="110" Height="40"
                       Canvas.Left="{Binding ToCustomerX}" Canvas.Top="{Binding ToCustomerY}" />

                <!-- 8b: Steine, je Farbe eine ItemsControl, die fuer jeden Eintrag der Liste ein Rechteck erzeugt -->
                <ItemsControl ItemsSource="{Binding RedBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding BrickColor}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding BlueBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding BrickColor}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding YellowBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding BrickColor}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding GreenBricks}" Width="900" Height="600">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegoBrickViewModel">
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding BrickColor}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 8c: Roboter, ueber den Steinen. Ein getragener Stein ragt seitlich heraus und bleibt so sichtbar -->
                <Rectangle x:Name="robotRectangle" Width="70" Height="50" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}" >
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="{Binding RobotRotationAngle}" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <ImageBrush Source="avares://smartFactoryApp/Assets/robot.png" />
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Grid>

        <!-- Steuerpanel im beigen Bereich des Fabrikplans (x 601 bis 899) -->
        <Border HorizontalAlignment="Left" Margin="601,0,0,0" Width="299" Padding="14,10">
            <StackPanel>

                <!-- 8d: Timer der Foerderbaender starten/stoppen -->
                <TextBlock Classes="header" Text="BAENDER" />
                <!-- Laborblatt 5: Baender sind beim Start leer, ein Klick legt Steine mit Zufallsfarben an -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="SetupButton" Classes="pad wide" Content="Setup" FontSize="16"
                            ToolTip.Tip="Setup Production Lines: Steine mit Zufallsfarben an die Baender legen"
                            Click="SetupProductionLines_Click" />
                    <Button x:Name="StartButton" Classes="pad wide" Content="Start" FontSize="16" ToolTip.Tip="Foerderbaender starten" Click="StartTimer_Click" />
                    <Button x:Name="StopButton"  Classes="pad wide" Content="Stop"  FontSize="16" ToolTip.Tip="Foerderbaender anhalten" Click="StopTimer_Click" />
                </StackPanel>

                <TextBlock Classes="header" Text="BEWEGEN" />
                <!-- Bewegungsmodus: ein Schritt pro Klick oder Dauerfahrt bis Stop -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,0,0,4">
                    <RadioButton GroupName="Modus" Content="Schritt" FontSize="13" Foreground="#2D3320"
                                 IsChecked="{Binding Schrittbewegung}" />
                    <RadioButton GroupName="Modus" Content="Kontinuierlich" FontSize="13" Foreground="#2D3320"
                                 IsChecked="{Binding KontinuierlicheBewegung}" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                    <Button x:Name="UpLeftButton"    Classes="pad" Grid.Row="0" Grid.Column="0" Content="↖" ToolTip.Tip="Hoch links"   Click="MoveUpLeft_Click" />
                    <Button x:Name="UpButton"        Classes="pad" Grid.Row="0" Grid.Column="1" Content="↑" ToolTip.Tip="Hoch"         Click="MoveUp_Click" />
                    <Button x:Name="UpRightButton"   Classes="pad" Grid.Row="0" Grid.Column="2" Content="↗" ToolTip.Tip="Hoch rechts"  Click="MoveUpRight_Click" />
                    <Button x:Name="LeftButton"      Classes="pad" Grid.Row="1" Grid.Column="0" Content="←" ToolTip.Tip="Links"        Click="MoveLeft_Click" />
                    <Button x:Name="StopButtonRobot" Classes="pad stop" Grid.Row="1" Grid.Column="1" Content="■" ToolTip.Tip="Roboter anhalten" Click="Stop_Click" />
                    <Button x:Name="RightButton"     Classes="pad" Grid.Row="1" Grid.Column="2" Content="→" ToolTip.Tip="Rechts"       Click="MoveRight_Click" />
                    <Button x:Name="DownLeftButton"  Classes="pad" Grid.Row="2" Grid.Column="0" Content="↙" ToolTip.Tip="Runter links" Click="MoveDownLeft_Click" />
                    <Button x:Name="DownButton"      Classes="pad" Grid.Row="2" Grid.Column="1" Content="↓" ToolTip.Tip="Runter"       Click="MoveDown_Click" />
                    <Button x:Name="DownRightButton" Classes="pad" Grid.Row="2" Grid.Column="2" Content="↘" ToolTip.Tip="Runter rechts" Click="MoveDownRight_Click" />
                </Grid>

                <TextBlock Classes="header" Text="DREHEN UND GREIFEN" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RotateLeftButton"  Classes="pad" Content="↺" ToolTip.Tip="Gegen den Uhrzeigersinn" Click="RotateLeft_Click" />
                    <Button x:Name="ResetRotationButton" Classes="pad reset" Content="0°" ToolTip.Tip="Orientierung auf 0° zuruecksetzen" Click="ResetRotation_Click" />
                    <Button x:Name="RotateRightButton" Classes="pad" Content="↻" ToolTip.Tip="Im Uhrzeigersinn"        Click="RotateRight_Click" />
                    <Button x:Name="UndockButton" Classes="pad wide" Content="Loslassen" FontSize="14" ToolTip.Tip="Gegriffenen Stein loslassen" Click="Undock_Click" />
                </StackPanel>
                
                <TextBlock Text="{Binding UndockInfo}" TextWrapping="Wrap" FontSize="13"
                    Foreground="#2D3320" Margin="0,6,0,0" />

                <!-- Laborblatt 5: Order-Tabelle links, Positionsanzeige rechts daneben (sonst reicht die Hoehe nicht) -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="header" Text="AUFTRAG" />
                        <Grid ColumnDefinitions="56,*,*" RowDefinitions="26,22,22,22,22" RowSpacing="3">
                            <Button x:Name="OrderButton" Classes="pad" Grid.Row="0" Grid.Column="0" Content="Order"
                                    Width="56" Height="24" Margin="0" FontSize="12" Padding="0"
                                    ToolTip.Tip="Zufaelligen Auftrag ueber 8 Steine erzeugen" Click="Order_Click" />
                            <TextBlock Classes="label" Grid.Row="0" Grid.Column="1" Text="Best." FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Classes="label" Grid.Row="0" Grid.Column="2" Text="Gelief." FontSize="12" HorizontalAlignment="Center" />

                            <Border Grid.Row="1" Background="#F9E00A" CornerRadius="4"><TextBlock Text="gelb" FontSize="12" Foreground="#2D3320" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Classes="value" Grid.Row="1" Grid.Column="1" FontSize="15" HorizontalAlignment="Center" Text="{Binding YellowOrder}" />
                            <TextBlock Classes="value" Grid.Row="1" Grid.Column="2" FontSize="15" HorizontalAlignment="Center" Text="{Binding YellowDelivered}" />

                            <Border Grid.Row="2" Background="#4462DA" CornerRadius="4"><TextBlock Text="blau" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Classes="value" Grid.Row="2" Grid.Column="1" FontSize="15" HorizontalAlignment="Center" Text="{Binding BlueOrder}" />
                            <TextBlock Classes="value" Grid.Row="2" Grid.Column="2" FontSize="15" HorizontalAlignment="Center" Text="{Binding BlueDelivered}" />

                            <Border Grid.Row="3" Background="#A41125" CornerRadius="4"><TextBlock Text="rot" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Classes="value" Grid.Row="3" Grid.Column="1" FontSize="15" HorizontalAlignment="Center" Text="{Binding RedOrder}" />
                            <TextBlock Classes="value" Grid.Row="3" Grid.Column="2" FontSize="15" HorizontalAlignment="Center" Text="{Binding RedDelivered}" />

                            <Border Grid.Row="4" Background="#299D24" CornerRadius="4"><TextBlock Text="gruen" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Classes="value" Grid.Row="4" Grid.Column="1" FontSize="15" HorizontalAlignment="Center" Text="{Binding GreenOrder}" />
                            <TextBlock Classes="value" Grid.Row="4" Grid.Column="2" FontSize="15" HorizontalAlignment="Center" Text="{Binding GreenDelivered}" />
                        </Grid>
                    </StackPanel>
                    <!-- Logistikplan: was als Naechstes zu tun ist, ueber die ganze Breite unter Tabelle und Position -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding OrderInfo}" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,6,0,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="header" Text="POSITION" />
                        <Border Background="#DCE1C2" CornerRadius="10" Padding="10,8" Width="104">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                <TextBlock Classes="label" Grid.Row="0" Text="X" />
                                <TextBlock x:Name="textBoxX" Classes="value" Grid.Row="0" Grid.Column="1" FontSize="15" Text="{Binding RobotX, StringFormat='{}{0:0} px'}" />
                                <TextBlock Classes="label" Grid.Row="1" Text="Y" />
                                <TextBlock x:Name="textBoxY" Classes="value" Grid.Row="1" Grid.Column="1" FontSize="15" Text="{Binding RobotY, StringFormat='{}{0:0} px'}" />
                                <TextBlock Classes="label" Grid.Row="2" Text="∠" />
                                <TextBlock Classes="value" Grid.Row="2" Grid.Column="1" FontSize="15" Text="{Binding RobotRotationAngle, StringFormat='{}{0:0}°'}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

</Window>
