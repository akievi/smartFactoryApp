<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" 
        Height="600"
        Title="smartFactoryApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Image Source="avares://smartFactoryApp/Assets/factory_plan.png" Stretch="None"/>

        <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" >

            <Grid Height="95" Width="160" Canvas.Left="730" Canvas.Top="500">
                <Button x:Name="UpButton" Content="Up" HorizontalAlignment="Center" VerticalAlignment="Top" Width="40" FontSize="16" Click="MoveUp_Click" />
                <Button x:Name="DownButton" Content="Down" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="60" FontSize="16" Click="MoveDown_Click" />
                <Button x:Name="LeftButton" Content="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50" FontSize="16" Click="MoveLeft_Click" />
                <Button x:Name="RightButton" Content="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Width="55" FontSize="16" Click="MoveRight_Click" />
                <Button x:Name="UpLeftButton" Content="UL" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" FontSize="16" Click="MoveUpLeft_Click" />
                <Button x:Name="UpRightButton" Content="UR" HorizontalAlignment="Right" VerticalAlignment="Top" Width="50" FontSize="16" Click="MoveUpRight_Click" />
                <Button x:Name="DownLeftButton" Content="DL" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="50" FontSize="16" Click="MoveDownLeft_Click" />
                <Button x:Name="DownRightButton" Content="DR" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="50" FontSize="16" Click="MoveDownRight_Click" />
            </Grid>
            <Grid Height="95" Width="160" Canvas.Left="730" Canvas.Top="400">
                <Button x:Name="RotateRightButton" Content="RotateR" HorizontalAlignment="Right" VerticalAlignment="Center" Width="75" FontSize="16" Click="RotateRight_Click" />
                <Button x:Name="RotateLeftButton" Content="RotateL" HorizontalAlignment="Left" VerticalAlignment="Center" Width="75" FontSize="16" Click="RotateLeft_Click" />
            </Grid>
            <Rectangle x:Name="robotRectangle" Width="70" Height="50" Stroke="Black" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="{Binding RobotRotationAngle}" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <ImageBrush Source="avares://smartFactoryApp/Assets/robot_platform.png" />
                </Rectangle.Fill>
            </Rectangle>
            <TextBox x:Name="textBoxX" Canvas.Left="100" Canvas.Top="100" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotX}" />
            <TextBox x:Name="textBoxY" Canvas.Left="100" Canvas.Top="150" Width="20" Height="20" FontSize="20" IsReadOnly="True" Text="{Binding RobotY}" />
        </Canvas>
    </Grid>

</Window>
